# Copy to .env before `docker compose up` (the Makefile does this for you).

# Simulated clock: 1 simulated day = SIM_DAY_SECONDS real seconds.
SIM_DAY_SECONDS=300

# Optional: pin simulated day 0 to a specific UTC timestamp (e.g. right
# before a demo). Leave unset to default to UTC midnight of the day the
# stack starts. Format: YYYY-MM-DDTHH:MM:SS
# SIM_EPOCH=2026-01-01T00:00:00

# Kafka
KAFKA_TOPIC=trips.telemetry
KAFKA_DLQ_TOPIC=trips.dlq
KAFKA_PARTITIONS=3

# PostgreSQL (serving store + Airflow metadata DB)
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet_pw
POSTGRES_DB=fleet
AIRFLOW_DB=airflow

# Airflow UI
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Grafana UI
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Host port for Postgres (5432 is often taken by a local install)
POSTGRES_HOST_PORT=5434
GRAFANA_HOST_PORT=3001
AIRFLOW_HOST_PORT=8088
API_HOST_PORT=8000

# Fleet simulation
NUM_VEHICLES=40
EVENT_INTERVAL_SECONDS=3
IDLE_ALERT_MINUTES=3
MALFORMED_EVENT_RATE=0.02

# Profitability threshold: a vehicle is flagged unprofitable when its daily
# profit falls below this value (0.0 = unprofitable means any net loss).
UNPROFITABLE_THRESHOLD=0.0
